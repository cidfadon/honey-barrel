# flyctl launch added from .gitignore
# Python
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/.venv
**/*.egg-info

# SQLite (local dev)
**/*.db
**/*.db-journal

# Env
**/.env.bak
**/.env.*.local

# IDE
**/.vscode
**/.idea

# OS
**/.DS_Store
**/Thumbs.db

# Docker
**/*.log

# flyctl launch added from .venv/.gitignore
# Created by venv; see https://docs.python.org/3/library/venv.html
.venv/**/*

# flyctl launch added from openclaw-data/.gitignore
openclaw-data/**/workspace
openclaw-data/**/linuxbrew
openclaw-data/**/*.log
openclaw-data/**/tmp
openclaw-data/**/cache

# flyctl launch added from openclaw-data/linuxbrew/Homebrew/.gitignore
# First, ignore everything.
openclaw-data/linuxbrew/Homebrew/*

# Explicitly ignore OS X Finder thumbnail files.
openclaw-data/linuxbrew/Homebrew/**/.DS_Store

# Unignore the contents of `Library` as that's where our code lives.
!openclaw-data/linuxbrew/Homebrew/Library

# Ignore files within `Library` (again).
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/.npmignore
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/bin
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/doc
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/prof
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/.gem
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/.cargo
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/.subversion
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/coverage
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/junit
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/fs_leak_log
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/vendor/portable-ruby
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/vendor/brew-rs
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/rust/brew-rs
openclaw-data/linuxbrew/Homebrew/Library/Taps
openclaw-data/linuxbrew/Homebrew/Library/PinnedTaps
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/.byebug_history
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/.npm
openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/.rdbg_history

# Ignore Bundler files
openclaw-data/linuxbrew/Homebrew/**/**/.bundle/bin
openclaw-data/linuxbrew/Homebrew/**/**/.bundle/cache
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/.homebrew_gem_groups
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/.homebrew_vendor_version
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/bundler.lock
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/bin
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/build_info
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/cache
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/extensions
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/*/*
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/plugins
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/specifications

# Ignore Ruby gems for versions other than we explicitly vendor.
# Keep this in sync with the list in standalone/init.rb.
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/4.0.0

# Ignore Bundler binary files
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/**/*.bundle

# Ignore YARD files
openclaw-data/linuxbrew/Homebrew/**/**/.yardoc

# Unignore vendored gems
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/*/*COPYING*
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/*/*LICENSE*
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/*/lib
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/addressable-*/data
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/public_suffix-*/data

# Ignore partially included gems where we don't need all files
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/.*
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/*.md
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/*.rdoc
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/*.gemspec
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/Gemfile
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/Rakefile
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/examples
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/lib/**/*
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/lib/mechanize
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/lib/mechanize/http
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/lib/mechanize/http/content_disposition_parser.rb
!openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/lib/mechanize/version.rb
openclaw-data/linuxbrew/Homebrew/**/**/vendor/gems/mechanize-*/test

# Ignore dependencies we don't wish to vendor
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/ast-*
openclaw-data/linuxbrew/Homebrew/**/**/vendor/bundle/ruby/*/gems/benchmark-*
