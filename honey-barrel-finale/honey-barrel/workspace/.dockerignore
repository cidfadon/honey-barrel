# Ignore `bin` contents (again).
openclaw-data/linuxbrew/Homebrew/bin

# Unignore our `brew` script.
!openclaw-data/linuxbrew/Homebrew/bin/brew

# Unignore our configuration/completions/documentation.
!openclaw-data/linuxbrew/Homebrew/.devcontainer
!openclaw-data/linuxbrew/Homebrew/.github
!openclaw-data/linuxbrew/Homebrew/completions
!openclaw-data/linuxbrew/Homebrew/docs
!openclaw-data/linuxbrew/Homebrew/manpages
!openclaw-data/linuxbrew/Homebrew/CODEOWNERS

# Unignore our packaging files
!openclaw-data/linuxbrew/Homebrew/package
openclaw-data/linuxbrew/Homebrew/package/resources/LICENSE.rtf

# Ignore generated documentation site
openclaw-data/linuxbrew/Homebrew/docs/_site
openclaw-data/linuxbrew/Homebrew/docs/.jekyll-metadata
openclaw-data/linuxbrew/Homebrew/docs/vendor
openclaw-data/linuxbrew/Homebrew/docs/rubydoc

# Unignore our root-level metadata files.
!openclaw-data/linuxbrew/Homebrew/.dockerignore
!openclaw-data/linuxbrew/Homebrew/.editorconfig
!openclaw-data/linuxbrew/Homebrew/.gitignore
!openclaw-data/linuxbrew/Homebrew/.irb_config
!openclaw-data/linuxbrew/Homebrew/.licenses
!openclaw-data/linuxbrew/Homebrew/.licenses/**
!openclaw-data/linuxbrew/Homebrew/.ruby-version
!openclaw-data/linuxbrew/Homebrew/.shellcheckrc
!openclaw-data/linuxbrew/Homebrew/.vale.ini
!openclaw-data/linuxbrew/Homebrew/.yardopts
!openclaw-data/linuxbrew/Homebrew/CHANGELOG.md
!openclaw-data/linuxbrew/Homebrew/CONTRIBUTING.md
!openclaw-data/linuxbrew/Homebrew/Dockerfile
!openclaw-data/linuxbrew/Homebrew/Dockerfile.test.yml
!openclaw-data/linuxbrew/Homebrew/LICENSE.txt
!openclaw-data/linuxbrew/Homebrew/README.md

# Unignore tests' bundle config
!openclaw-data/linuxbrew/Homebrew/Library/Homebrew/test/.bundle/config

# Unignore editor configuration
!openclaw-data/linuxbrew/Homebrew/.sublime
openclaw-data/linuxbrew/Homebrew/.sublime/homebrew.sublime-workspace
!openclaw-data/linuxbrew/Homebrew/.vscode

# Unignore AI configuration
!openclaw-data/linuxbrew/Homebrew/.cursor
!openclaw-data/linuxbrew/Homebrew/.claude

# Ignore local AI configuration
openclaw-data/linuxbrew/Homebrew/.claude/settings.local.json

# Ignore tmp files
openclaw-data/linuxbrew/Homebrew/**/**/tmp
fly.toml
